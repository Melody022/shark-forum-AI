# ============================================
# paicoding-ai 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# 应用端口
APP_PORT=8081

# 数据库配置
DB_URL=jdbc:mysql://127.0.0.1:3306/paicoding_ai?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your-password-here

# Redis 配置（用于停止生成等分布式状态管理）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AI 模型配置（兼容 OpenAI 接口的均可，如 DeepSeek、通义千问等）
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-api-key-here
AI_MODEL=deepseek-chat

# MIMO 多模态聊天（默认聊天模型）
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=your-mimo-api-key
MIMO_MODEL=mimo-v2.5

# 阿里云 Embedding，与聊天模型独立
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v4

# 模型配置表中的 API Key 加密密钥，生产环境必须替换
MODEL_PROVIDER_SECRET_KEY=replace-with-a-long-random-secret

# 开发管理后台访问令牌；生产环境必须设置，并通过 X-Admin-Token 请求头发送
ADMIN_RAG_TOKEN=replace-with-a-random-admin-token

# DeepSeek 备用 LLM
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your-deepseek-api-key

# LiteParse + 阿里云 OCR（可选）
LITEPARSE_COMMAND=lit
FILE_PARSING_LITEPARSE_OCR_ENABLED=true
ALIYUN_OCR_ENABLED=false
ALIYUN_OCR_ACCESS_KEY_ID=your-access-key-id
ALIYUN_OCR_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_OCR_CALLBACK_TOKEN=replace-with-a-random-callback-token
